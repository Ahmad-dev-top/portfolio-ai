# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# In production these go in your host's environment variables panel instead.

GROQ_API_KEY=gsk_your_new_rotated_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Signs admin session tokens. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_SECRET=

# PBKDF2 hash of your passphrase. Generate: python -m app.auth "your passphrase"
# Hash looks like salt:hex — do not use old salt$hex form (Compose breaks on $).
ADMIN_PASS_HASH=

# Origins allowed to call this API. Lock to your own domain.
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5500

DB_PATH=./data/portfolio.db
SITE_PATH=./site

# Auto-commit Studio content to GitHub on every Apply (optional)
GITHUB_SYNC_ENABLED=true
GITHUB_TOKEN=github_pat_or_classic_token_here
GITHUB_REPO=Ahmad-dev-top/your-portfolio-repo
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=site/content.json
